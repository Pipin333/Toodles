# ============================================================================
# Tooodles Music Bot - Ejemplo de Variables de Entorno (.env.example)
# Copia este archivo como `.env` y completa tus credenciales antes de iniciar.
# ============================================================================

# Token del Bot de Discord (Obligatorio - Discord Developer Portal)
token_priv=tu_discord_bot_token_aqui

# Credenciales de API de Spotify (Opcionales: habilitan enlaces de Spotify, Radio y Audio Features)
client_id=tu_spotify_client_id_aqui
client_secret=tu_spotify_client_secret_aqui

# URI de Base de Datos (Opcional: por defecto usa sqlite:///tooodles.db con modo WAL)
DATABASE_URL=sqlite:///tooodles.db

# Clave simétrica Fernet de 32 bytes base64 para cifrar cookies en reposo en AppConfig
FERNET_KEY=

# Persistencia global por defecto de colas ante reinicios (true / false)
PERSIST_QUEUES=false

# Lista opcional de proxies HTTP/SOCKS separados por coma para rotación en yt-dlp
PROXY_LIST=
YTDLP_PROXIES=

# Contenido opcional de cookies en formato Netscape (si no se usa cookies.txt en disco)
cookies=

# Límites de hilos BLAS/OpenMP para entrenamiento offline del RecSys en VPS de 1 vCPU
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
